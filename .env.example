# YouSkipAI (YSA) - Configuration Template

# Google Gemini API Key (Required for high-precision LLM detection)
YSA_GOOGLE_API_KEY=your_api_key_here

# Strategy Settings
YSA_USE_LLM=true
YSA_LLM_MODEL_NAME=gemini-2.5-flash

# Advanced Settings (Defaults usually work fine)
YSA_CONFIDENCE_THRESHOLD=0.35
YSA_MERGE_THRESHOLD_SECONDS=30.0
YSA_WINDOW_SECONDS=15.0
YSA_CACHE_DIR=.cache
