# YouSkipAI (YSA) - Configuration Template

# API KEY (Mandatory for Gemini LLM)
# Get yours at: https://aistudio.google.com/
YSA_GOOGLE_API_KEY=your_google_api_key_here

# LLM STRATEGY
YSA_USE_LLM=true
YSA_LLM_MODEL_NAME=gemini-2.5-flash

# EMBEDDING ENGINE (Fallback or Secondary Filter)
# Recommended for multilingual: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
YSA_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
YSA_CONFIDENCE_THRESHOLD=0.35

# ADVANCED PROCESSING
YSA_WINDOW_SECONDS=15.0
YSA_MERGE_THRESHOLD_SECONDS=30.0
YSA_CACHE_DIR=.cache

# REFERENCE PHRASES
# Pipe-separated phrases used to build the "Sponsor" semantic profile.
# YSA_REFERENCE_PHRASES="this video is sponsored by|merci à notre partenaire|..."
